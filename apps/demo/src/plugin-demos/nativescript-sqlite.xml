<Page xmlns="http://schemas.nativescript.org/tns.xsd" navigatingTo="navigatingTo" class="page">
    <Page.actionBar>
        <ActionBar title="nativescript-sqlite" icon="" class="action-bar">
        </ActionBar>
    </Page.actionBar>
    <StackLayout class="p-20">
        <ScrollView class="h-full">
          <StackLayout>
            <Label text="─── Benchmarks ───" class="h3 text-center m-b-10"/>
            <Button text="Run Full Benchmark Suite" tap="{{ benchmarkAll }}" class="btn btn-primary m-b-5"/>
            <Button text="Run Quick Benchmark Suite (smoke)" tap="{{ benchmarkQuick }}" class="btn btn-outline m-b-5"/>
          </StackLayout>
        </ScrollView>
    </StackLayout>
</Page>

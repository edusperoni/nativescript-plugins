{
	"extends": "nx/presets/core.json",
	"workspaceLayout": {
		"appsDir": "apps",
		"libsDir": "packages"
	},
	"$schema": "./node_modules/nx/schemas/nx-schema.json",
	"pluginsConfig": {
		"@nx/js": {
			"analyzeSourceFiles": true
		}
	},
	"namedInputs": {
		"default": ["{projectRoot}/**/*", "sharedGlobals"],
		"sharedGlobals": ["{workspaceRoot}/workspace.json", "{workspaceRoot}/tsconfig.base.json", "{workspaceRoot}/tslint.json", "{workspaceRoot}/nx.json"],
		"production": ["default", "!{projectRoot}/.eslintrc.json"]
	},
	"targetDefaults": {
		"build": {
			"inputs": ["production", "^production"],
			"cache": true
		},
		"lint": {
			"inputs": ["default", "{workspaceRoot}/.eslintrc.json"],
			"cache": true
		},
		"build.all": {
			"cache": true
		},
		"test": {
			"cache": true
		},
		"e2e": {
			"cache": true
		},
		"nx-release-publish": {
			"dependsOn": ["build.all"],
			"options": {
				"packageRoot": "dist/{projectRoot}"
			}
		}
	},
	"nxCloudAccessToken": "ZjgxOTNkNmUtOGYwZS00MzJjLWIxNDgtYTg2MzY0MWMzMzUwfHJlYWQ=",
	"useInferencePlugins": false,
	"defaultBase": "main",
	"release": {
		"releaseTagPattern": "{projectName}@{version}",
		"projects": ["packages/*"],
		"projectsRelationship": "independent",
		"version": {
			"generatorOptions": {
				"updateDependents": "never"
			}
		},
		"changelog": {
			"workspaceChangelog": false,
			"automaticFromRef": true,
			"projectChangelogs": {
				"createRelease": "github",
				"renderOptions": {
					"authors": true,
					"commitReferences": true,
					"versionTitleDate": true
				}
			}
		}
	},
	"useLegacyCache": true
}
